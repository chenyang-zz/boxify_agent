# Project
# 当前运行环境标识
ENV=development
# 应用日志级别
LOG_LEVEL=INFO
# Legacy YAML import source for the first admin app config; runtime app config is stored in DB.
APP_CONFIG_FILEPATH=config.yaml

# Database
# PostgreSQL 异步连接地址
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/boxify

# Redis
# Redis 主机地址
REDIS_HOST=localhost
# Redis 监听端口
REDIS_PORT=6379
# Redis 默认数据库编号
REDIS_DB=0
# Redis 访问密码，未设置时留空
REDIS_PASSWORD=

# Celery
# Celery broker 地址，用于任务派发
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery result backend 地址，用于任务结果或状态存储
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Elasticsearch
# Elasticsearch HTTP 地址
ELASTICSEARCH_URL=
# Elasticsearch 用户名，未启用安全认证时留空
ELASTICSEARCH_USERNAME=
# Elasticsearch 密码，未启用安全认证时留空
ELASTICSEARCH_PASSWORD=
# Elasticsearch 请求超时时间，单位为秒
ELASTICSEARCH_REQUEST_TIMEOUT=30

# Notebook
# Notebook 知识库 embedding 向量维度，需与索引和模型输出一致
NOTEBOOK_EMBEDDING_DIMS=1024

# Memory graph
# Neo4j stores long-term memory entities, relations, reflections, and active recall context.
# Neo4j Bolt 连接地址
NEO4J_URI=bolt://localhost:7687
# Neo4j 登录用户名
NEO4J_USERNAME=neo4j
# Neo4j 登录密码，生产环境请替换
NEO4J_PASSWORD=neo4j-password
# Neo4j database 名称
NEO4J_DATABASE=neo4j

# Short-term memory promotion thresholds and profile enhancement scope.
# 短期记忆被访问达到该次数后才允许提升为长期记忆
MEMORY_CONSOLIDATE_MIN_ACCESS=3
# 短期记忆重要性达到该分数后才允许提升为长期记忆
MEMORY_CONSOLIDATE_MIN_IMPORTANCE=0.8
# 短期记忆被提及达到该次数后才允许提升为长期记忆
MEMORY_CONSOLIDATE_MIN_MENTION=3
# 短期记忆创建超过该小时数后才参与长期记忆巩固
MEMORY_CONSOLIDATE_MIN_AGE_HOURS=24
# 每次巩固时最多增强画像的长期实体数量
MEMORY_CONSOLIDATE_PROFILE_TOP_K=20

# Memory reflection trigger, candidate sampling, and insight count limits.
# 新增记忆累计达到该数量后触发反思流程
MEMORY_REFLECTION_TRIGGER_THRESHOLD=10
# 反思时最多选取的候选实体数量
MEMORY_REFLECTION_TOP_K=30
# 候选实体少于该数量时跳过反思
MEMORY_REFLECTION_MIN_ENTITIES=5
# 每个实体参与反思的陈述采样数量
MEMORY_REFLECTION_STMT_PER_ENTITY=5
# 单次反思至少保留的洞察数量
MEMORY_REFLECTION_MIN_INSIGHTS=1
# 单次反思最多生成的洞察数量
MEMORY_REFLECTION_MAX_INSIGHTS=5

# Active recall limits used when injecting memory context into Agent messages.
# 主动召回允许占用的最长时间，单位为秒
MEMORY_ACTIVE_RECALL_TIMEOUT_SECONDS=3.5
# 主动召回时最多返回的实体记忆数量
MEMORY_ACTIVE_RECALL_ENTITY_TOP_K=3
# 主动召回时最多返回的反思洞察数量
MEMORY_ACTIVE_RECALL_INSIGHT_TOP_K=3
# 主动召回结果进入上下文的最低相关性分数
MEMORY_ACTIVE_RECALL_MIN_SCORE=0.72
# 注入 Agent 上下文的主动召回文本最大字符数
MEMORY_ACTIVE_RECALL_MAX_CHARS=1200

# Tencent COS
# 腾讯云 COS SecretId
COS_SECRET_ID=
# 腾讯云 COS SecretKey
COS_SECRET_KEY=
# COS bucket 所在地域
COS_REGION=ap-shanghai
# COS 访问协议
COS_SCHEME=https
# COS bucket 名称
COS_BUCKET=
# COS 自定义访问域名，为空时使用默认域名
COS_DOMAIN=

# Sandbox
# 沙箱服务地址
SANDBOX_ADDRESS=localhost
# 沙箱容器镜像名称
SANDBOX_IMAGE=boxify-sandbox
# 沙箱容器名称前缀
SANDBOX_NAME_PREFIX=boxify-sandbox
# 沙箱默认保留时长，单位为分钟
SANDBOX_TTL_MINUTES=60
# 沙箱容器加入的 Docker 网络
SANDBOX_NETWORK=
# 沙箱内 Chrome 启动参数
SANDBOX_CHROME_ARGS=
# 沙箱内 HTTPS 代理配置
SANDBOX_HTTPS_PROXY=
# 沙箱内 HTTP 代理配置
SANDBOX_HTTP_PROXY=
# 沙箱内不走代理的地址列表
SANDBOX_NO_PROXY=

# LLM
# DeepSeek API Key 示例占位，真实运行配置优先使用数据库用户配置
DEEPSEEK_API_KEY=

# Auth
# JWT 签名密钥，生产环境必须替换
AUTH_SECRET_KEY=change-me-in-production
# Access token 有效期，单位为分钟
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# GitHub OAuth App Client ID
GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth App Client Secret
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub OAuth callback URL, e.g. http://localhost:8000/api/auth/oauth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
# Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth Client Secret
GOOGLE_OAUTH_CLIENT_SECRET=
# Google OAuth callback URL, e.g. http://localhost:8000/api/auth/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# OAuth state有效期，单位为秒
OAUTH_STATE_TTL_SECONDS=600
# OAuth provider HTTP请求超时，单位为秒
OAUTH_HTTP_TIMEOUT_SECONDS=10
# OAuth登录成功后的前端回跳地址；为空时callback继续返回JSON
OAUTH_FRONTEND_REDIRECT_URI=
# 首次启动初始化管理员用户名
ADMIN_USERNAME=admin
# 首次启动初始化管理员密码，生产环境必须替换
ADMIN_PASSWORD=change-me-in-production

# App config encryption
# Recommended: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A stable plain secret string is also accepted and will be derived into a Fernet key.
# 数据库用户独立应用配置加密密钥，生产环境需保持稳定
APP_CONFIG_ENCRYPTION_KEY=
